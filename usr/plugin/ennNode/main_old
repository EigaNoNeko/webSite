    public function getLangueItems($channel) {
        $reqAllTitle = CMS->DataBase->execute(
            'SELECT * FROM pvs_channel_obj WHERE channel_id = ? AND type = "channel-title" AND content != ""',
            [$channel]
        )->fetchAll();
        $reqAllDescription = CMS->DataBase->execute(
            'SELECT * FROM pvs_channel_obj WHERE channel_id = ? AND type = "channel-description" AND content != ""',
            [$channel]
        )->fetchAll();

        $buffLang = [];
        $buffChannelInfo = [];
        foreach ($reqAllTitle as $key => $value) {
            $lang = $value['name'];
            $buffLang[] = $lang;

            $title = $value['content'];
            $description = CMS->GFunction->htmlDecode($reqAllDescription[$key]['content'] ?? '');
            $buffChannelInfo[$lang] = [
                'title' => $title,
                'description' => $description,
            ];
        }

        if(isset($buffChannelInfo['french'])) $langId = 'french';
        else $langId = $buffLang[0] ?? '';

        return [
            'default' => $langId,
            'default_item' => $buffChannelInfo[$langId] ?? [],
            'items' => $buffChannelInfo
        ];
    }

