	public function constructAPI($header, $body, $meta = []) {
        header('Content-Type: application/json');
        header("Access-Control-Allow-Origin: *");
        $returnAPI = [
        	"meta" => $meta,
            "header" => $header,
            "body" => $body
        ];
        return json_encode($returnAPI);
    }
