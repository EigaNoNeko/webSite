    private function getIp(){
        if(!empty($_SERVER['HTTP_CLIENT_IP'])){
            $ip = $_SERVER['HTTP_CLIENT_IP'];
        }elseif(!empty($_SERVER['HTTP_X_FORWARDED_FOR'])){
            $ip = $_SERVER['HTTP_X_FORWARDED_FOR'];
        }else {
            $ip = $_SERVER['REMOTE_ADDR'];
        }
        return $ip;
    }

	public function request($urlRequest, $bodyRequest = []) {
        $bodyRequest['http_client'] = $this->getIp();
		$context = NULL;
		if(isset($bodyRequest)) {
			$postdata = http_build_query($bodyRequest);
			$opts = array('http' =>
			    array(
			        'method'  => 'POST',
			        'header'  => 'Content-Type: application/x-www-form-urlencoded',
			        'content' => $postdata
			    )
			);
			$context  = stream_context_create($opts);
		}
		$result = @file_get_contents($urlRequest, false, $context);

		if(!$result)
			die(json_encode(['meta' => ['stream_get' => $urlRequest, 'message' => 'ERROR de requette', 'data' => $result]]));

		$data = json_decode($result, true);
		if(!$data) {
			die(json_encode(['meta' => ['stream_get' => $urlRequest, 'stream_body' => $bodyRequest, 'message' => 'ERROR de reponse', 'data' => $result]]));
		}

		return $data;
	}
